{
  "$defs": {
    "Finding": {
      "additionalProperties": false,
      "description": "A structured validation warning, error, or evidence-based finding.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "population": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population"
        },
        "caveat": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caveat"
        },
        "evidence": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Evidence",
          "type": "object"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FitDiagnostics": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ok",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "converged": {
          "title": "Converged",
          "type": "boolean"
        },
        "n_iter": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Iter"
        },
        "objective": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Objective"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "status",
        "converged"
      ],
      "title": "FitDiagnostics",
      "type": "object"
    },
    "FitProvenance": {
      "additionalProperties": false,
      "properties": {
        "n": {
          "title": "N",
          "type": "integer"
        },
        "n_pos": {
          "title": "N Pos",
          "type": "integer"
        },
        "prob_range": {
          "items": {
            "type": "number"
          },
          "title": "Prob Range",
          "type": "array"
        },
        "input_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Sha256"
        },
        "id_kind": {
          "title": "Id Kind",
          "type": "string"
        },
        "id_digest_salt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id Digest Salt"
        },
        "id_digests": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id Digests"
        },
        "entity_digests": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Digests"
        },
        "timestamp_max": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp Max"
        },
        "note": {
          "default": "ID digests are salted SHA-256 prefixes used only to detect role overlap; they are not anonymisation.",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "n",
        "n_pos",
        "prob_range",
        "id_kind"
      ],
      "title": "FitProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_type": {
      "const": "calibcheck.calibrator",
      "default": "calibcheck.calibrator",
      "title": "Artifact Type",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "method": {
      "enum": [
        "identity",
        "sigmoid",
        "isotonic",
        "temperature"
      ],
      "title": "Method",
      "type": "string"
    },
    "params": {
      "additionalProperties": true,
      "title": "Params",
      "type": "object"
    },
    "input_transform": {
      "title": "Input Transform",
      "type": "string"
    },
    "output_rule": {
      "title": "Output Rule",
      "type": "string"
    },
    "clip_eps": {
      "title": "Clip Eps",
      "type": "number"
    },
    "positive_label": {
      "title": "Positive Label",
      "type": "string"
    },
    "label_column": {
      "title": "Label Column",
      "type": "string"
    },
    "model_association": {
      "description": "The probability column / model this map was fitted for.",
      "title": "Model Association",
      "type": "string"
    },
    "fitted_on": {
      "$ref": "#/$defs/FitProvenance"
    },
    "fit_config": {
      "additionalProperties": true,
      "title": "Fit Config",
      "type": "object"
    },
    "diagnostics": {
      "$ref": "#/$defs/FitDiagnostics"
    },
    "calibcheck_version": {
      "default": "0.1.0",
      "title": "Calibcheck Version",
      "type": "string"
    },
    "created_utc": {
      "default": "",
      "title": "Created Utc",
      "type": "string"
    }
  },
  "required": [
    "method",
    "params",
    "input_transform",
    "output_rule",
    "clip_eps",
    "positive_label",
    "label_column",
    "model_association",
    "fitted_on",
    "diagnostics"
  ],
  "title": "CalibratorArtifact",
  "type": "object"
}
{
  "$defs": {
    "AnalysisConfig": {
      "additionalProperties": false,
      "description": "Everything that determines a CalibCheck analysis. Exported with every run.",
      "properties": {
        "columns": {
          "$ref": "#/$defs/ColumnMapping"
        },
        "positive_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Positive Label"
        },
        "missing_policy": {
          "default": "fail",
          "enum": [
            "fail",
            "drop"
          ],
          "title": "Missing Policy",
          "type": "string"
        },
        "transforms": {
          "additionalProperties": {
            "enum": [
              "percent",
              "logit"
            ],
            "type": "string"
          },
          "description": "Explicit, recorded per-column transforms: 'percent' divides by 100, 'logit' applies the logistic function. Never applied implicitly.",
          "title": "Transforms",
          "type": "object"
        },
        "clip_eps": {
          "default": 1e-15,
          "exclusiveMaximum": 0.001,
          "minimum": 2.220446049250313e-16,
          "title": "Clip Eps",
          "type": "number"
        },
        "threshold": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Threshold",
          "type": "number"
        },
        "reference_prevalence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Prevalence from training/development data, used as a fixed reference.",
          "title": "Reference Prevalence"
        },
        "binning": {
          "$ref": "#/$defs/BinningConfig"
        },
        "uncertainty": {
          "$ref": "#/$defs/UncertaintyConfig"
        },
        "dependence": {
          "default": "independent",
          "enum": [
            "independent",
            "entity_clustered",
            "time_dependent",
            "unknown"
          ],
          "title": "Dependence",
          "type": "string"
        },
        "groups": {
          "$ref": "#/$defs/GroupConfig"
        },
        "time_window": {
          "anyOf": [
            {
              "enum": [
                "D",
                "W",
                "M",
                "Q",
                "Y"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Window"
        },
        "privacy": {
          "$ref": "#/$defs/PrivacyConfig"
        },
        "reference_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Model"
        },
        "pairwise": {
          "default": false,
          "title": "Pairwise",
          "type": "boolean"
        },
        "primary_metric": {
          "anyOf": [
            {
              "enum": [
                "brier",
                "log_loss"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary Metric"
        },
        "max_file_mb": {
          "default": 500.0,
          "exclusiveMinimum": 0,
          "title": "Max File Mb",
          "type": "number"
        },
        "max_columns": {
          "default": 2000,
          "minimum": 1,
          "title": "Max Columns",
          "type": "integer"
        }
      },
      "title": "AnalysisConfig",
      "type": "object"
    },
    "BinStat": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        },
        "closed": {
          "enum": [
            "left",
            "both"
          ],
          "title": "Closed",
          "type": "string"
        },
        "count": {
          "title": "Count",
          "type": "integer"
        },
        "n_pos": {
          "title": "N Pos",
          "type": "integer"
        },
        "mean_pred": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mean Pred"
        },
        "observed_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Rate"
        },
        "signed_gap": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "mean_pred - observed_rate; positive means predictions exceed the observed rate",
          "title": "Signed Gap"
        },
        "abs_gap": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Abs Gap"
        },
        "ci_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci Low"
        },
        "ci_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci High"
        },
        "ci_status": {
          "default": "skipped",
          "enum": [
            "ok",
            "unavailable",
            "failed",
            "skipped"
          ],
          "title": "Ci Status",
          "type": "string"
        },
        "ci_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci Reason"
        },
        "low_support": {
          "default": false,
          "title": "Low Support",
          "type": "boolean"
        }
      },
      "required": [
        "index",
        "lower",
        "upper",
        "closed",
        "count",
        "n_pos",
        "mean_pred",
        "observed_rate",
        "signed_gap",
        "abs_gap"
      ],
      "title": "BinStat",
      "type": "object"
    },
    "BinningConfig": {
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "default": "uniform",
          "enum": [
            "uniform",
            "quantile"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "n_bins": {
          "default": 10,
          "maximum": 200,
          "minimum": 1,
          "title": "N Bins",
          "type": "integer"
        },
        "min_support": {
          "default": 30,
          "description": "Practical warning threshold per bin (heuristic).",
          "minimum": 1,
          "title": "Min Support",
          "type": "integer"
        },
        "sensitivity": {
          "default": true,
          "title": "Sensitivity",
          "type": "boolean"
        },
        "sensitivity_bins": {
          "items": {
            "type": "integer"
          },
          "title": "Sensitivity Bins",
          "type": "array"
        },
        "sensitivity_strategies": {
          "items": {
            "enum": [
              "uniform",
              "quantile"
            ],
            "type": "string"
          },
          "title": "Sensitivity Strategies",
          "type": "array"
        }
      },
      "title": "BinningConfig",
      "type": "object"
    },
    "BinningResult": {
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "enum": [
            "uniform",
            "quantile"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "n_bins_requested": {
          "title": "N Bins Requested",
          "type": "integer"
        },
        "n_bins_actual": {
          "title": "N Bins Actual",
          "type": "integer"
        },
        "n_nonempty": {
          "title": "N Nonempty",
          "type": "integer"
        },
        "edges": {
          "items": {
            "type": "number"
          },
          "title": "Edges",
          "type": "array"
        },
        "edge_rule": {
          "title": "Edge Rule",
          "type": "string"
        },
        "edge_source": {
          "title": "Edge Source",
          "type": "string"
        },
        "bins": {
          "items": {
            "$ref": "#/$defs/BinStat"
          },
          "title": "Bins",
          "type": "array"
        },
        "min_support_nonempty": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Min Support Nonempty"
        },
        "support_threshold": {
          "title": "Support Threshold",
          "type": "integer"
        },
        "ci_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci Method"
        },
        "ci_level": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci Level"
        }
      },
      "required": [
        "strategy",
        "n_bins_requested",
        "n_bins_actual",
        "n_nonempty",
        "edges",
        "edge_rule",
        "edge_source",
        "bins",
        "min_support_nonempty",
        "support_threshold"
      ],
      "title": "BinningResult",
      "type": "object"
    },
    "ClipInfo": {
      "additionalProperties": false,
      "properties": {
        "eps": {
          "title": "Eps",
          "type": "number"
        },
        "n_clipped_low": {
          "title": "N Clipped Low",
          "type": "integer"
        },
        "n_clipped_high": {
          "title": "N Clipped High",
          "type": "integer"
        },
        "applies_to": {
          "items": {
            "type": "string"
          },
          "title": "Applies To",
          "type": "array"
        },
        "note": {
          "default": "Clipping is a numerical stabilisation used only inside logarithms/logits; Brier loss, bins and summaries use the original probabilities.",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "eps",
        "n_clipped_low",
        "n_clipped_high",
        "applies_to"
      ],
      "title": "ClipInfo",
      "type": "object"
    },
    "ColumnMapping": {
      "additionalProperties": false,
      "description": "Which CSV columns play which role. Probability columns are never guessed.",
      "properties": {
        "label": {
          "default": "y_true",
          "title": "Label",
          "type": "string"
        },
        "probs": {
          "items": {
            "type": "string"
          },
          "title": "Probs",
          "type": "array"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "entity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity"
        },
        "timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp"
        },
        "split": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Split"
        },
        "groups": {
          "items": {
            "type": "string"
          },
          "title": "Groups",
          "type": "array"
        }
      },
      "title": "ColumnMapping",
      "type": "object"
    },
    "ComparisonResult": {
      "additionalProperties": false,
      "properties": {
        "reference": {
          "title": "Reference",
          "type": "string"
        },
        "candidate": {
          "title": "Candidate",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "definition": {
          "title": "Definition",
          "type": "string"
        },
        "delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Delta"
        },
        "status": {
          "enum": [
            "ok",
            "unavailable",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "favours": {
          "enum": [
            "candidate",
            "reference",
            "neither",
            "undetermined"
          ],
          "title": "Favours",
          "type": "string"
        },
        "n": {
          "title": "N",
          "type": "integer"
        },
        "population": {
          "title": "Population",
          "type": "string"
        },
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "edge_policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edge Policy"
        }
      },
      "required": [
        "reference",
        "candidate",
        "metric",
        "definition",
        "delta",
        "status",
        "favours",
        "n",
        "population"
      ],
      "title": "ComparisonResult",
      "type": "object"
    },
    "DatasetOverview": {
      "additionalProperties": false,
      "properties": {
        "n_rows_input": {
          "title": "N Rows Input",
          "type": "integer"
        },
        "n_rows_retained": {
          "title": "N Rows Retained",
          "type": "integer"
        },
        "n_rows_excluded": {
          "title": "N Rows Excluded",
          "type": "integer"
        },
        "exclusions": {
          "items": {
            "$ref": "#/$defs/Exclusion"
          },
          "title": "Exclusions",
          "type": "array"
        },
        "missing_policy": {
          "enum": [
            "fail",
            "drop"
          ],
          "title": "Missing Policy",
          "type": "string"
        },
        "n_pos": {
          "title": "N Pos",
          "type": "integer"
        },
        "n_neg": {
          "title": "N Neg",
          "type": "integer"
        },
        "prevalence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Prevalence"
        },
        "label_column": {
          "title": "Label Column",
          "type": "string"
        },
        "positive_label": {
          "title": "Positive Label",
          "type": "string"
        },
        "negative_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Negative Label"
        },
        "label_mapping": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Label Mapping",
          "type": "object"
        },
        "probability_meaning": {
          "title": "Probability Meaning",
          "type": "string"
        },
        "models": {
          "items": {
            "type": "string"
          },
          "title": "Models",
          "type": "array"
        },
        "id_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Id Column"
        },
        "id_kind": {
          "enum": [
            "provided",
            "positional"
          ],
          "title": "Id Kind",
          "type": "string"
        },
        "metadata_fields": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Metadata Fields",
          "type": "object"
        },
        "group_columns": {
          "items": {
            "type": "string"
          },
          "title": "Group Columns",
          "type": "array"
        },
        "prob_ranges": {
          "additionalProperties": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "object"
          },
          "title": "Prob Ranges",
          "type": "object"
        },
        "analysis_population": {
          "title": "Analysis Population",
          "type": "string"
        }
      },
      "required": [
        "n_rows_input",
        "n_rows_retained",
        "n_rows_excluded",
        "missing_policy",
        "n_pos",
        "n_neg",
        "prevalence",
        "label_column",
        "positive_label",
        "negative_label",
        "label_mapping",
        "probability_meaning",
        "models",
        "id_column",
        "id_kind",
        "metadata_fields",
        "group_columns",
        "prob_ranges",
        "analysis_population"
      ],
      "title": "DatasetOverview",
      "type": "object"
    },
    "Exclusion": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "count": {
          "title": "Count",
          "type": "integer"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        }
      },
      "required": [
        "reason",
        "count"
      ],
      "title": "Exclusion",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "A structured validation warning, error, or evidence-based finding.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "population": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population"
        },
        "caveat": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caveat"
        },
        "evidence": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Evidence",
          "type": "object"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "Finding",
      "type": "object"
    },
    "GroupConfig": {
      "additionalProperties": false,
      "properties": {
        "max_groups": {
          "default": 12,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Groups",
          "type": "integer"
        },
        "min_group_size": {
          "default": 30,
          "minimum": 1,
          "title": "Min Group Size",
          "type": "integer"
        },
        "max_cardinality": {
          "default": 50,
          "maximum": 10000,
          "minimum": 2,
          "title": "Max Cardinality",
          "type": "integer"
        }
      },
      "title": "GroupConfig",
      "type": "object"
    },
    "GroupResult": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "title": "Column",
          "type": "string"
        },
        "n_groups_total": {
          "title": "N Groups Total",
          "type": "integer"
        },
        "n_groups_shown": {
          "title": "N Groups Shown",
          "type": "integer"
        },
        "n_groups_examined": {
          "title": "N Groups Examined",
          "type": "integer"
        },
        "other_bucket": {
          "title": "Other Bucket",
          "type": "boolean"
        },
        "missing_category_present": {
          "title": "Missing Category Present",
          "type": "boolean"
        },
        "edges": {
          "items": {
            "type": "number"
          },
          "title": "Edges",
          "type": "array"
        },
        "edge_policy": {
          "title": "Edge Policy",
          "type": "string"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/GroupRow"
          },
          "title": "Rows",
          "type": "array"
        },
        "interpretation": {
          "default": "Descriptive subgroup performance differences on this data. They do not establish causality, discrimination, or legal fairness.",
          "title": "Interpretation",
          "type": "string"
        },
        "exploratory": {
          "default": true,
          "title": "Exploratory",
          "type": "boolean"
        }
      },
      "required": [
        "column",
        "n_groups_total",
        "n_groups_shown",
        "n_groups_examined",
        "other_bucket",
        "missing_category_present",
        "edges",
        "edge_policy",
        "rows"
      ],
      "title": "GroupResult",
      "type": "object"
    },
    "GroupRow": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "n": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "N"
        },
        "n_pos": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "N Pos"
        },
        "prevalence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Prevalence"
        },
